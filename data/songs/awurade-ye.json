      "lines": [
        { "primary": "Awurade ye", "translation": "The Lord is good" },
        { "primary": "Ɔyɛ papa", "translation": "He is gracious" },
        { "primary": "N'adɔe wɔ hɔ daa", "translation": "His love endures forever" }
